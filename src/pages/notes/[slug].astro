---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/dynamic.css";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	return notes
		.filter((entry) => !entry.data.draft)
		.map((entry) => ({
			params: { slug: entry.id },
			props: { note: entry },
		}));
}

const { note } = Astro.props;
const title = note.data.title || note.id;
const description = note.data.description || "";
const date = note.data.published
	? new Date(note.data.published).toLocaleDateString("zh-CN", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: "";

const { Content } = await render(note);
---

<MainGridLayout title={title} description={description}>
    <article class="page-shell" aria-labelledby="note-title">
        <header class="page-header card-base" style="margin-bottom: 1.5rem;">
            <div class="page-heading">
                <div class="page-icon" aria-hidden="true">
                    <Icon name="andrsrxn:notes" />
                </div>
                <div>
                    <h1 id="note-title">{title}</h1>
                    {date && (
                        <p style="margin-top: 0.25rem; font-size: 0.9rem; color: var(--text-secondary, #888);">
                            {date}
                        </p>
                    )}
                </div>
            </div>
        </header>
        <div class="card-base" style="padding: 2rem;">
            <!-- ✅ 渲染 Markdown 内容 -->
            <Content />
        </div>
        <div style="margin-top: 1.5rem;">
            <a
                href={`${import.meta.env.BASE_URL}notes/`}
                style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;"
            >
                <Icon name="material-symbols:arrow-back-rounded" />
                <span>返回笔记列表</span>
            </a>
        </div>
    </article>
</MainGridLayout>